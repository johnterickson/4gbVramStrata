# Keep the image to the source only: everything generated is re-created on
# first start (inside the container or on the /data volume).
.git

# local Python environment (rebuilt in the image)
.venv/
__pycache__/
*.pyc
.pytest_cache/

# setup.py outputs and downloads (engine, packs, models, logs)
/engine*/
/build/
/build*/
/dist/
/packs/
/mtp/
/models/
/Strata-data/
third_party/llama.cpp*/
third_party/*.zip
*.done
*.log
strata-*.json
strata-*.json.bak
strata-*.txt
run-*.sh
run-*.bat

# Machine-specific settings and private working files are never image contents.
.env
.env.*
.local/
.strata/
.strata-mcp/
configs/
apps/
designs/
.vscode/
.idea/
.cursor/
.ccache/
